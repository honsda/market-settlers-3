{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "anreu",
	"main": "bot/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Alerts, news announcements, and the wiki market feed are polled here.
		// Every five minutes keeps the free plan well inside request limits.
		"crons": ["*/5 * * * *"]
	},
	"secrets": {
		// DISCORD_PUBLIC_KEY is optional: when it is absent the Worker fetches
		// the application verify_key with DISCORD_TOKEN on first use.
		"required": [
			"DISCORD_TOKEN",
			"DISCORD_CLIENT_ID",
			"SUPABASE_URL",
			"SUPABASE_SECRET_KEY",
			"APP_URL"
		]
	}
}
