{
	"name": "market-settlers-3",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"bot": "tsx watch bot/index.ts",
		"bot:start": "tsx bot/index.ts",
		"bot:deploy": "tsx bot/deploy-commands.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "tsx scripts/reset.ts && tsx scripts/seed.ts",
		"dev:all": "concurrently -n web,bot -c cyan,magenta \"npm:dev\" \"npm:bot\""
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0",
		"concurrently": "^9.2.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"discord.js": "^14.27.0"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
