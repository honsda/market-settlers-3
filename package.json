{
	"name": "settlers3",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"deploy:bot": "wrangler deploy --config wrangler.bot.jsonc",
		"deploy:all": "npm run deploy && npm run deploy:bot",
		"bot:cloudflare:dev": "wrangler dev --config wrangler.bot.jsonc",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.cloudflare.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"bot": "tsx watch bot/index.ts",
		"bot:start": "tsx --tsconfig tsconfig.bot.json bot/index.ts",
		"bot:deploy": "tsx bot/deploy-commands.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "tsx scripts/reset.ts && tsx scripts/seed.ts",
		"db:push-schema": "tsx scripts/push-schema.ts",
		"dev:all": "concurrently -n web,bot -c cyan,magenta \"npm:dev\" \"npm:bot\""
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261106.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0",
		"@types/sanitize-html": "^2.16.2",
		"concurrently": "^9.2.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.7",
		"@supabase/supabase-js": "^2.118.0",
		"@tiptap/core": "^3.32.2",
		"@tiptap/extension-image": "^3.32.2",
		"@tiptap/extension-placeholder": "^3.32.2",
		"@tiptap/starter-kit": "^3.32.2",
		"discord.js": "^14.27.0",
		"sanitize-html": "^2.18.1",
		"tsx": "^4.20.6"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true,
		"workerd": true
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
