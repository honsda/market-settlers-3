# ── Web app ────────────────────────────────────────────────────────────────
# Local development only. On Cloudflare, set the website values on the web
# Worker and the bot values on the separate anreu Worker (see README →
# Deployment).
#
# Public URL of the dashboard. Used in Discord embeds and map/alert links.
APP_URL=http://localhost:5173

# Where the shared SQLite database lives. The web app and bot must agree.
# MARKET_DB_PATH=data/market.db

# ── Price alerts ───────────────────────────────────────────────────────────
# Percentage move in the best bid/ask that counts as "significant".
ALERT_THRESHOLD_PCT=8

# Minimum minutes between two alerts for the same item and direction.
ALERT_COOLDOWN_MINUTES=45

# How often the bot checks the alert queue.
ALERT_POLL_SECONDS=20

# ── Newsroom announcements ─────────────────────────────────────────────────
# How often the bot checks for newly published articles.
NEWS_POLL_SECONDS=20

# ── Live shop feed ─────────────────────────────────────────────────────────
# Official Settlers III market feed used by the wiki market page.
WIKI_MARKET_URL=https://wiki.settlers-mc.org/data/market.json

# How often the bot checks the feed. The server writes it every 60 seconds.
WIKI_MARKET_POLL_SECONDS=60

# How often to post a batched "market pulse" to the market channel.
WIKI_MARKET_SUMMARY_MINUTES=30

# How often to post the profitable market spread board. Default is hourly.
WIKI_MARKET_PROFIT_MINUTES=60

# Post an immediate market-move alert when a new trade's average is this far
# from the item's previous 7-day average.
WIKI_MARKET_ALERT_THRESHOLD_PCT=12

# Minimum minutes between two market-move alerts for the same item.
WIKI_MARKET_ALERT_COOLDOWN_MINUTES=60

# ── Discord bot ────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# General Information → Application ID
DISCORD_CLIENT_ID=

# General Information → Public Key. Optional for the free Cloudflare Worker:
# when empty, the Worker fetches the application verify_key with DISCORD_TOKEN.
# Not used by the gateway bot.
DISCORD_PUBLIC_KEY=

# Optional. Set to your dev server ID for instant slash-command registration.
# Leave empty to register commands globally (up to ~1 hour to appear).
DISCORD_GUILD_ID=

# Optional. Set only when running the gateway bot with its health endpoint.
# The bot listens on PORT when the host provides one (Render does), and falls
# back to BOT_HEALTH_PORT. The Dockerfile sets BOT_HEALTH_PORT=3000.
# BOT_HEALTH_PORT=3000

# Render only. The bot pings its own /health so the free instance does not spin
# down. Render provides RENDER_EXTERNAL_URL automatically; KEEPALIVE_URL is a
# manual override for other hosts. Set SELF_KEEPALIVE_MINUTES to 0 or leave the
# URL empty to disable the self-ping.
SELF_KEEPALIVE_MINUTES=10
# KEEPALIVE_URL=https://anreu.onrender.com

# Free Cloudflare Worker only. Optional second keep-alive: the Worker's
# five-minute Cron ticks ping this Render URL instead of posting alerts
# itself. The self-ping above is enough for normal use; this also recovers the
# service after a crash. Leave empty to let the Worker own the scheduled posts.
# RENDER_BOT_URL=https://anreu.onrender.com

# Channel that receives market alerts. Can also be set in Discord with /alerts.
DISCORD_ALERT_CHANNEL_ID=

# Channel that receives new article announcements. Optional: when empty, the
# bot looks for a channel named #news in DISCORD_GUILD_ID.
DISCORD_NEWS_CHANNEL_ID=

# The gateway bot (not the free Cloudflare Worker) also needs the Server Members
# privileged intent for join roles and member lookups, plus Manage Roles, Manage
# Channels and Manage Messages for the Dweller/Citizen roles, #staff-verify, the
# #apply cleanup and pinned guides.

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and API keys. The secret key is server-only; the publishable
# key can be used in the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Staff key for the web newsroom. Moderators enter this at /news/moderation
# to approve images before they can appear in published articles.
NEWS_MODERATOR_KEY=

# sqlite | supabase. Defaults to supabase when the URL and secret key are set.
# Set MARKET_BACKEND=sqlite to keep using the local demo database.
# MARKET_BACKEND=supabase

# Personal access token used only by `npm run db:push-schema`.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
