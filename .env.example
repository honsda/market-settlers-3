# ── Web app ────────────────────────────────────────────────────────────────
# Public URL of the dashboard. Used in Discord embeds and map/alert links.
APP_URL=http://localhost:5173

# Where the shared SQLite database lives. The web app and bot must agree.
# MARKET_DB_PATH=data/market.db

# ── Price alerts ───────────────────────────────────────────────────────────
# Percentage move in the best bid/ask that counts as "significant".
ALERT_THRESHOLD_PCT=8

# Minimum minutes between two alerts for the same item and direction.
ALERT_COOLDOWN_MINUTES=45

# How often the bot checks the alert queue.
ALERT_POLL_SECONDS=20

# ── Live shop feed ─────────────────────────────────────────────────────────
# Official Settlers III market feed used by the wiki market page.
WIKI_MARKET_URL=https://wiki.settlers-mc.org/data/market.json

# How often the bot checks the feed. The server writes it every 60 seconds.
WIKI_MARKET_POLL_SECONDS=60

# How often to post a batched "market pulse" to the market channel.
WIKI_MARKET_SUMMARY_MINUTES=30

# Post an immediate market-move alert when a new trade's average is this far
# from the item's previous 7-day average.
WIKI_MARKET_ALERT_THRESHOLD_PCT=12

# Minimum minutes between two market-move alerts for the same item.
WIKI_MARKET_ALERT_COOLDOWN_MINUTES=60

# ── Discord bot ────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# General Information → Application ID
DISCORD_CLIENT_ID=

# Optional. Set to your dev server ID for instant slash-command registration.
# Leave empty to register commands globally (up to ~1 hour to appear).
DISCORD_GUILD_ID=

# Channel that receives market alerts. Can also be set in Discord with /alerts.
DISCORD_ALERT_CHANNEL_ID=

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL and API keys. The secret key is server-only; the publishable
# key can be used in the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# sqlite | supabase. Defaults to supabase when the URL and secret key are set.
# Set MARKET_BACKEND=sqlite to keep using the local demo database.
# MARKET_BACKEND=supabase

# Personal access token used only by `npm run db:push-schema`.
# Create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
