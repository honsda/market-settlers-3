# ── Web app ────────────────────────────────────────────────────────────────
# Public URL of the dashboard. Used in Discord embeds and map/alert links.
APP_URL=http://localhost:5173

# Where the shared SQLite database lives. The web app and bot must agree.
# MARKET_DB_PATH=data/market.db

# ── Price alerts ───────────────────────────────────────────────────────────
# Percentage move in the best bid/ask that counts as "significant".
ALERT_THRESHOLD_PCT=8

# Minimum minutes between two alerts for the same item and direction.
ALERT_COOLDOWN_MINUTES=45

# How often the bot checks the alert queue.
ALERT_POLL_SECONDS=20

# ── Discord bot ────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# General Information → Application ID
DISCORD_CLIENT_ID=

# Optional. Set to your dev server ID for instant slash-command registration.
# Leave empty to register commands globally (up to ~1 hour to appear).
DISCORD_GUILD_ID=

# Channel that receives market alerts. Can also be set in Discord with /alerts.
DISCORD_ALERT_CHANNEL_ID=
